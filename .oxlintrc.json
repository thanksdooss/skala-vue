{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "unicorn",
    "oxc",
    "vue"
  ],
  "env": {
    "browser": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "public/vesseljs/source/**",
    "public/vesseljs/examples/3D_engine/**",
    "dist/**",
    "coverage/**"
  ]
}
