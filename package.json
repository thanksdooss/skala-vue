{
  "name": "skala-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --mac",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "build": {
    "appId": "com.skala.marine",
    "productName": "SKALA marine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js"
    ],
    "mac": {
      "target": "dir",
      "icon": null,
      "category": "public.app-category.education"
    },
    "extraResources": [
      {
        "from": "public/vesseljs",
        "to": "vesseljs"
      }
    ]
  },
  "dependencies": {
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "element-plus": "^2.14.2",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "suncalc": "^2.0.1",
    "three": "^0.185.1",
    "vue": "^3.5.32",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "globals": "^17.5.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
